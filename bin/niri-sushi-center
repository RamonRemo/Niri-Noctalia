#!/usr/bin/env python3
# Mantem o preview do Sushi (Espaco no Nautilus) sempre centralizado.
#
# O niri centraliza a janela flutuante pelo PRIMEIRO tamanho que ela pede. O
# Sushi abre grande (ex.: 1687x1172), a window-rule (max-width/max-height em
# cfg/rules.kdl) encolhe depois, e o canto superior esquerdo fica onde estava:
# a janela sai do centro. O mesmo acontece quando ele troca de arquivo (setas no
# Nautilus) e se redimensiona pro conteudo novo.
#
# Fixar o tamanho na regra (default-column-width/height) centraliza, mas mata o
# "maximo": imagem pequena passa a abrir na caixa inteira. Entao aqui a gente
# escuta o event-stream e da center-window toda vez que o TAMANHO muda. So
# tamanho: mover nao dispara nada, entao arrastar a janela na mao nao briga.

import json
import subprocess

APP_ID = "org.gnome.NautilusPreviewer"


def center(window_id):
    subprocess.run(
        ["niri", "msg", "action", "center-window", "--id", str(window_id)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    sizes = {}  # id da janela do Sushi -> ultimo tamanho visto
    floating = {}  # id -> is_floating (se for pro tiling, nao centraliza)

    def check(wid, layout):
        size = (layout or {}).get("window_size")
        if size is None or sizes.get(wid) == size:
            return
        sizes[wid] = size
        if floating.get(wid, True):
            center(wid)

    proc = subprocess.Popen(
        ["niri", "msg", "--json", "event-stream"],
        stdout=subprocess.PIPE,
        text=True,
    )

    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue

        for kind, data in event.items():
            if kind == "WindowsChanged":
                # Snapshot inicial, logo apos conectar: so registra o que ja
                # esta aberto, sem mexer.
                for w in data.get("windows", []):
                    if w.get("app_id") == APP_ID:
                        sizes[w["id"]] = (w.get("layout") or {}).get("window_size")
                        floating[w["id"]] = w.get("is_floating", True)

            elif kind == "WindowOpenedOrChanged":
                w = data.get("window", {})
                if w.get("app_id") == APP_ID:
                    sizes.setdefault(w["id"], None)
                    floating[w["id"]] = w.get("is_floating", True)
                    check(w["id"], w.get("layout"))

            elif kind == "WindowLayoutsChanged":
                for wid, layout in data.get("changes", []):
                    if wid in sizes:
                        check(wid, layout)

            elif kind == "WindowClosed":
                sizes.pop(data.get("id"), None)
                floating.pop(data.get("id"), None)


if __name__ == "__main__":
    main()
