// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// You will have to remove "/-" and edit it before it takes effect.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// Monitor menor (2560x1080), fica em cima fisicamente
output "HDMI-A-1" {
    mode "2560x1080@60.000"
    scale 1
    position x=0 y=0
}

// Monitor maior (3440x1440, 160Hz) — o "principal", fica embaixo fisicamente
output "DP-2" {
    mode "3440x1440@159.962"
    scale 1
    position x=0 y=1080
}