// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// You will have to remove "/-" and edit it before it takes effect.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// No niri o y=0 e o TOPO e cresce pra baixo. Os dois com x=0 = alinhados
// exatamente na vertical (bordas esquerdas coladas), sem passagem torta do mouse.

// OLED (SMARTGAME+), agora no DP-1. E o "principal", fica embaixo fisicamente.
// Suporta 240Hz - antes ficava preso em 160 porque o cabo estava no DP-2.
output "DP-1" {
    mode "3440x1440@240.085"
    scale 1
    position x=0 y=1440
}

// ULTRAWIDE (3440x1440, 160Hz), agora no DP-2. Fica em cima.
output "DP-2" {
    mode "3440x1440@159.962"
    scale 1
    position x=0 y=0
}

// Fallback: se voltar a ligar o monitor de cima pelo HDMI (limitado a 85Hz),
// ele assume a mesma posicao de cima. Nao colide porque so um conecta por vez.
output "HDMI-A-1" {
    mode "3440x1440@84.957"
    scale 1
    position x=0 y=0
}
