animations {
    workspace-switch {
        spring damping-ratio=0.9 stiffness=1200 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=0.9 stiffness=1100 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.9 stiffness=1300 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=1150 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=1200 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.9 stiffness=1600 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 120
        curve "ease-out-cubic"
    }
    overview-open-close {
        spring damping-ratio=0.9 stiffness=1150 epsilon=0.0001
    }
}
